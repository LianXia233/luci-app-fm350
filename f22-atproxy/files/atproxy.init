#!/bin/sh /etc/rc.common
# atproxy —— F22 AP 侧 EIF 语义代理（只读 URC 注入）
#
# 订阅 MIPC EIF_IND 并降维输出 +GT* URC 到 /dev/ttyGS1。
# 依赖：/usr/bin/atproxy（本固件 libmipc_msg.so/libmipc_api.so 动态链接）。
# 注意：必须在 usb.init（START=99）配置完 USB gadget 之后启动，
#       因此取 START=99 且本脚本自身用 procd respawn 保活。

USE_PROCD=1
NAME=atproxy
START=99
STOP=10

start_service() {
    [ -x /usr/bin/atproxy ] || {
        echo "atproxy: /usr/bin/atproxy missing, skip"
        return 1
    }
    procd_open_instance
    procd_set_param command /usr/bin/atproxy
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
