#!/bin/sh /etc/rc.common
# dropbear —— F22 AP 域 SSH 服务（embind4 植入）
#
# 经 USB ADB 隧道转出：主机侧 adb forward tcp:2222 tcp:22 后
# ssh -p 2222 root@127.0.0.1 即得 AP 域 root shell。
# 也可 adb forward tcp:8080 tcp:80 直接访问 AP 域 LuCI（uhttpd）。
#
# 安全模型：
#   - 本固件 shadow 中 root 无哈希（root::），dropbear 以 -B 允许空密码
#     登录（含配套源码补丁：password 方法空哈希 + allowblankpass 放行）。
#     暴露面与 adbd_usb 免认证 root 完全一致，仅 USB 可达，不新增风险。
#   - 一旦通过 passwd 给 root 设置密码，空哈希条件消失，-B 自动失效，
#     密码校验路径接管，无需改动本脚本。
#   - host key 由 -R 在首连接时自动生成于 /etc/dropbear/（tmpfs，重启后
#     重新生成，客户端 known_hosts 提示变更属预期）。

USE_PROCD=1
NAME=dropbear
START=95
STOP=10

start_service() {
    [ -x /usr/sbin/dropbear ] || {
        echo "dropbear: /usr/sbin/dropbear missing, skip"
        return 1
    }
    mkdir -p /etc/dropbear /var/run
    procd_open_instance
    procd_set_param command /usr/sbin/dropbear -F -E -p 22 -B -R -T 3
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
